# Puerto del servidor
PORT=3000

# URL publica donde se va a desplegar la app (usada para generar los QR de los puntos de control)
# Ejemplo: https://rondas.tuempresa.com
PUBLIC_URL=http://localhost:3000

# --- Credenciales iniciales (solo se usan la primera vez que arranca, para crear las cuentas) ---
SEED_SUPERVISOR_USER=supervisor
SEED_SUPERVISOR_PASS=cambia-esta-clave
SEED_GUARD_USER=vigilante
SEED_GUARD_PASS=cambia-esta-clave

# --- Envio de alertas por email (metodo mas barato: SMTP, coste 0) ---
# Puedes usar Gmail con una "contrasena de aplicacion", Brevo, Zoho, etc. Todos tienen plan gratuito.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contrasena-de-aplicacion
SMTP_FROM="Rondas <tu-cuenta@gmail.com>"

# A donde llegan las alertas (puede ser tu email)
ALERT_EMAIL_TO=xdrnnm87pn@privaterelay.appleid.com
